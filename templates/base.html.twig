<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/glider.svg') }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <header>
            <nav>
                <ul class="nav">
                    <li><a href="{{ path('home') }}">Home</a></li>
                    <li><a href="{{ path('about') }}">About</a></li>
                    <li><a href="{{ path('lucky_number') }}">Lucky</a></li>
                    <li><a href="{{ path('report') }}">Report</a></li>
                    <li><a href="{{ path('cards') }}">Card</a></li>
                    <li><a href="{{ path('sessions_all') }}">Session</a></li>
                </ul>
            </nav>
        </header>
        
        {% block body %}{% endblock %}
        <footer>
            <ul>
                <li><a href="{{ path('api') }}">API</a></a></li>
            </ul>
        </footer>
    </body>
</html>

{% extends "base.html.twig" %}

{% block title %}Bibliotek - Lägg till ny bok{% endblock %}

{% block body %}
    <div class="library-container">
        <h1 class="library-header">Lägg till ny bok</h1>
        
        <div class="library-nav">
            <a href="{{ path('library_books') }}">← Tillbaka</a>
        </div>

        {% if errors is defined and errors is not empty %}
            <div class="error-list">
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form action="{{ path('library_create_submit') }}" method="POST" enctype="multipart/form-data" style="max-width: 600px; margin: 20px auto; text-align: left;">
            <div class="form-group">
                <label for="title">Titel <span class="required">*</span></label>
                <input type="text" id="title" name="title" required placeholder="T.ex. Harry Potter och de vises sten" value="{{ old.title|default('') }}">
            </div>

            <div class="form-group">
                <label for="isbn">ISBN <span class="required">*</span></label>
                <input type="text" id="isbn" name="isbn" required placeholder="T.ex. 978-3-16-148410-0" value="{{ old.isbn|default('') }}">
            </div>

            <div class="form-group">
                <label for="author">Författare <span class="required">*</span></label>
                <input type="text" id="author" name="author" required placeholder="T.ex. J.K. Rowling" value="{{ old.author|default('') }}">
            </div>

            <div class="form-group">
                <label for="image">Bokens bild-URL</label>
                <input type="text" id="image" name="image" placeholder="T.ex. img/book.jpg" value="{{ old.image|default('') }}">
            </div>

            <div class="form-actions">
                <button type="submit">Lägg till bok</button>
                <a href="{{ path('library_books') }}">Avbryt</a>
            </div>
        </form>

{% endblock %}

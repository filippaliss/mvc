{% extends "base.html.twig" %}

{% block title %}Bibliotek - {{ book.title }}{% endblock %}

{% block body %}
    <div class="library-container">
        <div class="library-nav">
            <a href="{{ path('library_books') }}">← Tillbaka</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="success-message">{{ message }}</div>
        {% endfor %}

        <div class="book-details">
            {% if book.image %}
                <img src="{{ book.image }}" alt="{{ book.title }}">
            {% endif %}
            
            <h1>{{ book.title }}</h1>
            
            <div class="book-info">
                <p><strong>Författare:</strong> {{ book.author }}</p>
                <p><strong>ISBN:</strong> <code>{{ book.isbn }}</code></p>
            </div>
            
            <div class="book-actions">
                <a href="{{ path('library_edit', {'isbn': book.isbn}) }}">✏️ Redigera bok</a>
                <form action="{{ path('library_delete', {'isbn': book.isbn}) }}" method="POST" class="book-delete-form">
                    <button type="submit" class="delete-button" onclick="return confirm('Radera denna bok?')">🗑️ Radera bok</button>
                </form>
            </div>
        </div>

{% endblock %}

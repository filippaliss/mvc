{% extends "base.html.twig" %}

{% block title %}Card Deck{% endblock %}

{% block body %}
    <div class="card-nav-links">
        <a href="{{ path('deck') }}">The Deck</a>
        <a href="{{ path('draw') }}">Draw a card</a>
        <a href="{{ path('shuffleDeck') }}">Shuffle deck</a>
        <a href="{{ path('game21_start') }}">Card Game</a>
    </div>

    <div class="card-container">
        {% for card in cards %}
            <div class="card">
                {{ card|raw }}
            </div>
        {% endfor %}
    </div>

{% endblock %}

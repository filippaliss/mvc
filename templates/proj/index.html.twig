{% extends "proj/base.html.twig" %}

{% block title %}Black Jack - Home{% endblock %}

{% block body %}
    <div style="text-align: center;">
        <h1 style="font-size: 3rem; margin-bottom: 1rem;">Welcome to Black Jack</h1>
        <p style="font-size: 1.3rem; margin: 2rem 0;">
            Experience the thrill of Black Jack - Play 1 to 3 hands simultaneously!
        </p>

        <div class="game-table" style="max-width: 800px; margin: 3rem auto;">
            <h2>Features</h2>
            <ul style="text-align: left; font-size: 1.1rem; line-height: 2rem;">
                <li>Play 1-3 hands simultaneously against the dealer</li>
                <li>Manage your bank account with bets</li>
                <li>Personalized experience with player names</li>
                <li>Follow official Black Jack rules</li>
                <li>Split pairs when you get matching cards</li>
                <li>Aim for 21 without going bust!</li>
            </ul>
        </div>

        <div style="margin: 3rem 0;">
            <a href="{{ path('proj_game') }}" class="btn" style="font-size: 1.3rem; padding: 1rem 3rem;">
                Start Playing
            </a>
        </div>

        <div style="margin: 3rem 0;">
            <h2>How to Play</h2>
            <p style="font-size: 1.1rem; max-width: 700px; margin: 1rem auto; line-height: 1.8;">
                Black Jack is a card game where you compete against the dealer to get as close to 21 as possible 
                without going over. Face cards (J, Q, K) are worth 10, Aces can be 1 or 11, and numbered cards 
                are worth their face value. You can Hit to take another card, or Stand to keep your current hand. 
                Beat the dealer to win!
            </p>
        </div>

        <div style="margin: 3rem 0;">
            <h2>Game Rules</h2>
            <ul style="text-align: left; font-size: 1.1rem; line-height: 2rem; max-width: 700px; margin: 1rem auto;">
                <li>Dealer must hit on 16 and below, stand on 17 and above</li>
                <li>Black Jack (21 with 2 cards) pays 1.5x your bet</li>
                <li>Ties (pushes) return your bet</li>
                <li>Split matching pairs to play two hands (doubles your bet)</li>
                <li>Going over 21 means you bust and lose your bet</li>
            </ul>
        </div>
    </div>
{% endblock %}

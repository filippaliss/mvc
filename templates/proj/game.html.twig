{% extends "proj/base.html.twig" %}

{% block title %}Play Black Jack{% endblock %}

{% block body %}
    <div class="proj-page proj-page-narrow">
        <h1 class="proj-title">Black Jack Game</h1>

        {% if playerName %}
            <div class="balance-display">
                <strong>👤 Player:</strong> {{ playerName }}<br>
                <strong>💰 Balance:</strong> {{ balance }} credits
            </div>

            <div class="game-table">
                <h2>Start a New Round</h2>
                <form method="post" action="{{ path('proj_start') }}" class="proj-form">
                    <label for="bet">💵 Bet Amount (per hand):</label>
                    <input type="number" id="bet" name="bet" min="1" max="{{ balance }}" value="10" required>

                    <label for="num_hands">Number of Hands (1-3):</label>
                    <select id="num_hands" name="num_hands" required>
                        <option value="1" selected>1 Hand</option>
                        <option value="2">2 Hands</option>
                        <option value="3">3 Hands</option>
                    </select>

                    <div class="form-actions">
                        <button type="submit" class="btn">🎲 Deal Cards</button>
                    </div>
                </form>
            </div>

            <div class="form-section-center">
                <form method="post" action="{{ path('proj_reset') }}" class="form-inline">
                    <button type="submit" class="btn btn-warning">🔄 Reset Game</button>
                </form>
            </div>
        {% else %}
            <div class="game-table">
                <h2>Welcome! Enter Your Name to Begin</h2>
                <form method="post" action="{{ path('proj_init') }}" class="proj-form">
                    <label for="player_name">👤 Your Name:</label>
                    <input type="text" id="player_name" name="player_name" required placeholder="Enter your name">

                    <div class="form-actions">
                        <button type="submit" class="btn">Start Playing</button>
                    </div>
                </form>

                <p class="form-note">
                    You'll start with <strong>1000 credits</strong> in your bank account. Good luck!
                </p>
            </div>
        {% endif %}

        <div class="game-table form-section-gap">
            <h2>Quick Rules</h2>
            <ul class="rules-list">
                <li>Get as close to 21 as possible without going over</li>
                <li>Face cards (J, Q, K) = 10 points</li>
                <li>Aces = 1 or 11 points</li>
                <li>Numbered cards = face value</li>
                <li>Black Jack (21 with 2 cards) pays 1.5x your bet</li>
                <li>Dealer must hit on 16 or below, stand on 17+</li>
                <li>Split matching pairs to play two hands</li>
            </ul>
        </div>
    </div>
{% endblock %}

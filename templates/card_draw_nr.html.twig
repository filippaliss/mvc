{% extends "base.html.twig" %}

{% block title %}Draw Card{% endblock %}

{% block body %}
    <div class="card-nav-links">
        <a href="{{ path('deck') }}">The Deck</a>
        <a href="{{ path('draw') }}">Draw a card</a>
        <a href="{{ path('shuffle_deck') }}">Shuffle deck</a>
        <a href="{{ path('game21_start') }}">Card Game</a>
    </div>
    
    <div class="card-container">
        {% for cardHTML in cards %}
            <div class="card">
                {{ cardHTML|raw }}  {# Each cardHTML is a string containing the HTML for a card #}
            </div>
        {% endfor %}
    </div>

{% endblock %}